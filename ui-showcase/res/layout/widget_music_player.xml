<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:theme="@style/Theme.Widget.Metrolist"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:id="@android:id/background"
    android:background="@drawable/widget_background"
    android:padding="16dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <ImageView
        android:id="@+id/widget_album_art"
        android:layout_width="88dp"
        android:layout_height="88dp"
        android:src="@mipmap/ic_launcher"
        android:scaleType="centerCrop"
        android:contentDescription="@string/album_art"/>
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginStart="16dp">
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp">
            <TextView
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="@color/widget_text_primary"
                android:ellipsize="end"
                android:id="@+id/widget_song_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/not_playing"
                android:maxLines="1"/>
            <TextView
                android:textSize="13sp"
                android:textColor="@color/widget_text_secondary"
                android:ellipsize="end"
                android:id="@+id/widget_artist_name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="@string/tap_to_play"
                android:maxLines="1"/>
        </LinearLayout>
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:baselineAligned="false">
            <FrameLayout
                android:background="@drawable/widget_like_button_bg"
                android:layout_width="48dp"
                android:layout_height="48dp">
                <ImageButton
                    android:id="@+id/widget_like_button"
                    android:background="@android:color/transparent"
                    android:padding="12dp"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:src="@drawable/ic_widget_heart_outline_nav"
                    android:scaleType="fitCenter"
                    android:contentDescription="@string/like"/>
            </FrameLayout>
            <FrameLayout
                android:id="@+id/widget_play_pause_container"
                android:background="@drawable/widget_play_pill_bg"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:layout_marginStart="12dp">
                <ImageView
                    android:layout_gravity="center"
                    android:id="@+id/widget_play_pause"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:src="@drawable/ic_widget_play"
                    android:contentDescription="@string/play_pause"/>
            </FrameLayout>
        </LinearLayout>
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="6dp"
            android:layout_marginTop="12dp">
            <ImageView
                android:id="@+id/widget_progress_track"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:src="@drawable/widget_progress_track"
                android:scaleType="fitXY"/>
            <ImageView
                android:id="@+id/widget_progress_fill"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:src="@drawable/widget_progress_clip"
                android:scaleType="fitXY"/>
        </FrameLayout>
    </LinearLayout>
</LinearLayout>
