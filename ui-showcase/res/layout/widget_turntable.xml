<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:theme="@style/Theme.Widget.Metrolist"
    android:id="@android:id/background"
    android:padding="4dp"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ImageView
        android:layout_gravity="center"
        android:id="@+id/widget_turntable_album_art"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:src="@drawable/widget_turntable_default_art"
        android:scaleType="fitCenter"
        android:contentDescription="@string/album_art"/>
    <LinearLayout
        android:gravity="center_vertical"
        android:layout_gravity="end|top"
        android:orientation="horizontal"
        android:background="@drawable/widget_turntable_nav_bg"
        android:layout_width="wrap_content"
        android:layout_height="36dp"
        android:layout_marginTop="20dp"
        android:layout_marginEnd="6dp">
        <ImageButton
            android:id="@+id/widget_turntable_prev_button"
            android:background="@android:color/transparent"
            android:padding="8dp"
            android:layout_width="36dp"
            android:layout_height="match_parent"
            android:src="@drawable/ic_widget_skip_previous"
            android:scaleType="fitCenter"
            android:contentDescription="@string/previous"/>
        <ImageButton
            android:id="@+id/widget_turntable_next_button"
            android:background="@android:color/transparent"
            android:padding="8dp"
            android:layout_width="36dp"
            android:layout_height="match_parent"
            android:src="@drawable/ic_widget_skip_next"
            android:scaleType="fitCenter"
            android:contentDescription="@string/next"/>
    </LinearLayout>
    <FrameLayout
        android:layout_gravity="start|bottom"
        android:id="@+id/widget_turntable_play_container"
        android:background="@drawable/widget_turntable_play_bg"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:layout_marginBottom="12dp"
        android:layout_marginStart="12dp">
        <ImageView
            android:layout_gravity="center"
            android:id="@+id/widget_turntable_play_pause"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:src="@drawable/ic_widget_play_secondary"
            android:contentDescription="@string/play_pause"/>
    </FrameLayout>
</FrameLayout>
