<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:theme="@style/Theme.Widget.Metrolist"
    android:gravity="top"
    android:orientation="vertical"
    android:id="@android:id/background"
    android:background="@drawable/widget_background"
    android:paddingTop="12dp"
    android:paddingBottom="12dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingStart="14dp"
    android:paddingEnd="14dp">
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <ImageView
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:src="@mipmap/ic_launcher"
            android:scaleType="centerCrop"
            android:contentDescription="@string/album_art"/>
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="12dp">
            <TextView
                android:textSize="15sp"
                android:textStyle="bold"
                android:textColor="@color/widget_text_primary"
                android:ellipsize="end"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/not_playing"
                android:maxLines="1"/>
            <TextView
                android:textSize="12sp"
                android:textColor="@color/widget_text_secondary"
                android:ellipsize="end"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="@string/choose_something_below"
                android:maxLines="1"/>
            <LinearLayout
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="36dp"
                android:layout_marginTop="8dp">
                <ImageView
                    android:padding="7dp"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:src="@drawable/ic_widget_skip_previous"
                    android:contentDescription="@string/previous"/>
                <FrameLayout
                    android:background="@drawable/widget_play_pill_bg"
                    android:layout_width="48dp"
                    android:layout_height="36dp"
                    android:layout_marginStart="4dp"
                    android:layout_marginEnd="4dp">
                    <ImageView
                        android:layout_gravity="center"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:src="@drawable/ic_widget_play"
                        android:contentDescription="@string/play_pause"/>
                </FrameLayout>
                <ImageView
                    android:padding="7dp"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:src="@drawable/ic_widget_skip_next"
                    android:contentDescription="@string/next"/>
                <ImageView
                    android:padding="8dp"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:src="@drawable/ic_widget_heart_outline_nav"
                    android:contentDescription="@string/like"
                    android:layout_marginStart="6dp"/>
            </LinearLayout>
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="5dp"
                android:layout_marginTop="8dp">
                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:src="@drawable/widget_progress_track"
                    android:scaleType="fitXY"/>
                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:src="@drawable/widget_progress_clip"
                    android:scaleType="fitXY"/>
            </FrameLayout>
        </LinearLayout>
    </LinearLayout>
    <LinearLayout
        android:gravity="start"
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp">
        <LinearLayout style="@style/MetrolistPlaylistWidgetCard">
            <FrameLayout style="@style/MetrolistPlaylistWidgetArtworkFrame">
                <ImageView
                    android:src="@drawable/playlist_play"
                    style="@style/MetrolistPlaylistWidgetArtwork"/>
                <FrameLayout style="@style/MetrolistPlaylistWidgetCardPlayButton">
                    <ImageView style="@style/MetrolistPlaylistWidgetCardPlayIcon"/>
                </FrameLayout>
            </FrameLayout>
            <TextView
                android:text="@string/widget_playlists"
                style="@style/MetrolistPlaylistWidgetCardTitle"/>
        </LinearLayout>
        <LinearLayout style="@style/MetrolistPlaylistWidgetCard">
            <FrameLayout style="@style/MetrolistPlaylistWidgetArtworkFrame">
                <ImageView
                    android:src="@drawable/ic_widget_heart_nav"
                    style="@style/MetrolistPlaylistWidgetArtwork"/>
                <FrameLayout style="@style/MetrolistPlaylistWidgetCardPlayButton">
                    <ImageView style="@style/MetrolistPlaylistWidgetCardPlayIcon"/>
                </FrameLayout>
            </FrameLayout>
            <TextView
                android:text="@string/liked_songs"
                style="@style/MetrolistPlaylistWidgetCardTitle"/>
        </LinearLayout>
        <LinearLayout style="@style/MetrolistPlaylistWidgetCard">
            <FrameLayout style="@style/MetrolistPlaylistWidgetArtworkFrame">
                <ImageView
                    android:src="@drawable/cached"
                    style="@style/MetrolistPlaylistWidgetArtwork"/>
                <FrameLayout style="@style/MetrolistPlaylistWidgetCardPlayButton">
                    <ImageView style="@style/MetrolistPlaylistWidgetCardPlayIcon"/>
                </FrameLayout>
            </FrameLayout>
            <TextView
                android:text="@string/downloaded_songs"
                style="@style/MetrolistPlaylistWidgetCardTitle"/>
        </LinearLayout>
        <LinearLayout style="@style/MetrolistPlaylistWidgetCard">
            <FrameLayout style="@style/MetrolistPlaylistWidgetArtworkFrame">
                <ImageView
                    android:src="@drawable/trending_up"
                    style="@style/MetrolistPlaylistWidgetArtwork"/>
                <FrameLayout style="@style/MetrolistPlaylistWidgetCardPlayButton">
                    <ImageView style="@style/MetrolistPlaylistWidgetCardPlayIcon"/>
                </FrameLayout>
            </FrameLayout>
            <TextView
                android:text="@string/my_top"
                style="@style/MetrolistPlaylistWidgetCardTitle"/>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
