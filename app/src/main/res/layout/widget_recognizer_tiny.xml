<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:theme="@style/Theme.Widget.Metrolist"
    android:id="@+id/widget_recognizer_tiny_root"
    android:background="@drawable/widget_background"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ImageView
        android:layout_gravity="center"
        android:id="@+id/widget_recognizer_tiny_pulse"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:src="@drawable/widget_mic_pulse_idle"
        android:contentDescription="@null"/>
    <FrameLayout
        android:layout_gravity="center"
        android:id="@+id/widget_recognizer_tiny_mic_container"
        android:background="@drawable/widget_mic_button_bg"
        android:layout_width="50dp"
        android:layout_height="50dp">
        <ImageView
            android:layout_gravity="center"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/ic_widget_mic"
            android:contentDescription="@string/widget_recognizer_mic_desc"/>
    </FrameLayout>
</FrameLayout>
