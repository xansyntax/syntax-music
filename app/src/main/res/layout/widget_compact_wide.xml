<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:theme="@style/Theme.Widget.Metrolist"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:id="@android:id/background"
    android:background="@drawable/widget_background"
    android:paddingTop="8dp"
    android:paddingBottom="8dp"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:paddingStart="12dp"
    android:paddingEnd="12dp">
    <ImageView
        android:id="@+id/widget_wide_album_art"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:src="@mipmap/ic_launcher"
        android:scaleType="centerCrop"
        android:contentDescription="@string/album_art"/>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="vertical"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="12dp">
        <TextView
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="@color/widget_text_primary"
            android:ellipsize="end"
            android:id="@+id/widget_wide_song_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/not_playing"
            android:maxLines="1"/>
        <TextView
            android:textSize="12sp"
            android:textColor="@color/widget_text_secondary"
            android:ellipsize="end"
            android:id="@+id/widget_wide_artist_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="@string/tap_to_play"
            android:maxLines="1"/>
    </LinearLayout>
    <FrameLayout
        android:background="@drawable/widget_like_button_bg"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginEnd="8dp">
        <ImageButton
            android:id="@+id/widget_wide_like_button"
            android:background="@android:color/transparent"
            android:padding="10dp"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:src="@drawable/ic_widget_heart_outline_nav"
            android:scaleType="fitCenter"
            android:contentDescription="@string/like"/>
    </FrameLayout>
    <FrameLayout
        android:id="@+id/widget_wide_play_container"
        android:background="@drawable/widget_play_button_circular"
        android:layout_width="44dp"
        android:layout_height="44dp">
        <ImageView
            android:layout_gravity="center"
            android:id="@+id/widget_wide_play_pause"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:src="@drawable/ic_widget_play_low"
            android:contentDescription="@string/play_pause"/>
    </FrameLayout>
</LinearLayout>
